{
  "name": "FavoriteTeam",
  "type": "object",
  "properties": {
    "team_id": {
      "type": "string",
      "description": "Unique identifier for the team"
    },
    "team_name": {
      "type": "string",
      "description": "Display name of the team"
    },
    "league": {
      "type": "string",
      "enum": [
        "NFL",
        "NHL",
        "MLB",
        "NBA",
        "WNBA",
        "Premier League",
        "La Liga",
        "Serie A",
        "Bundesliga",
        "MLS",
        "NWSL",
        "NCAAF",
        "NCAAB",
        "NCAAB-Baseball",
        "F1",
        "International Football",
        "Women's International Football",
        "PWHL"
      ],
      "description": "The league/sport the team belongs to"
    },
    "logo_url": {
      "type": "string",
      "description": "URL to team logo"
    }
  },
  "required": [
    "team_id",
    "team_name",
    "league"
  ]
}